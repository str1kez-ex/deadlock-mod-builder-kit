{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deadlock Mod Build Kit",
  "version": "0.1.4",
  "identifier": "com.deadlock-mod-kit.app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Deadlock Mod Build Kit",
        "width": 1200,
        "height": 780,
        "minWidth": 980,
        "minHeight": 650,
        "resizable": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}